<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="Theme.Control" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->

        <!-- Đảm bảo không có Title/Action Bar -->
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
    </style>

    <!-- CÁC STYLE KHÁC PHẢI NẰM NGOÀI NÀY -->

    <!-- Style này có vẻ dư thừa vì Theme.Control đã có các item này -->
    <!-- Nếu muốn dùng riêng, nó cần có parent, ví dụ parent="Theme.Control" -->
    <style name="Theme.MyApplication.NoActionBar" parent="Theme.Control"> <!-- Hoặc parent phù hợp khác -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Style Fullscreen, nên có parent để kế thừa các thuộc tính khác -->
    <!-- Bạn sẽ áp dụng theme này cho Activity cụ thể trong Manifest nếu cần -->
    <style name="Theme.MyApplication.FullScreen" parent="Theme.Control"> <!-- Kế thừa từ theme chính -->
        <item name="android:windowFullscreen">true</item> <!-- Sử dụng android: namespace -->
        <!-- Có thể thêm các item khác nếu cần -->
    </style>

</resources>