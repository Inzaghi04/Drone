<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#282c34">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Tiêu đề -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drone Controller"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <!-- Nhập IP Address -->
        <LinearLayout
            android:id="@+id/ipContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/ipLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drone IP Address:"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="5dp" />

            <EditText
                android:id="@+id/droneIp"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:hint="Enter IP Address"
                android:textColor="#000000"
                android:background="@android:drawable/edit_text"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Container Joystick -->
        <LinearLayout
            android:id="@+id/joystickContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">

            <!-- Joystick trái -->
            <FrameLayout
                android:id="@+id/leftJoystick"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/joystick_bg"
                android:layout_margin="16dp">

                <View
                    android:id="@+id/leftKnob"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/knob_bg" />
            </FrameLayout>

            <!-- Joystick phải -->
            <FrameLayout
                android:id="@+id/rightJoystick"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/joystick_bg"
                android:layout_margin="16dp">

                <View
                    android:id="@+id/rightKnob"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:background="@drawable/knob_bg" />
            </FrameLayout>
        </LinearLayout>

        <!-- Switch ARM MODE -->
        <LinearLayout
            android:id="@+id/switchContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Switch
                android:id="@+id/armSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/switchLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARM MODE"
                android:textColor="#FFFFFF"
                android:layout_marginStart="10dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
